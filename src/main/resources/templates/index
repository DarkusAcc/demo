<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>


<h1>Inventario de Libros</h1>
<div id="app">
    <form>
        <label for="titulo">Titulo</label>
        <input type="text" id="titulo" v-model="book.titulo">

        <label for="autor">Autor</label>
        <input type="text" id="autor" v-model="book.autor">

        <label for="ventas">Ventas</label>
        <input type="number" id="ventas" v-model="book.ventas">

        <button type="button" @click="addBook">Agregar Libro</button>
    </form>
    <table>
        <thead>
            <tr>
                <th>Titulo</th>
                <th>Autor</th>
                <th>Ventas</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="book in books" :key="book.titulo">
                <td>{{ book.titulo }}</td>
                <td>{{ book.autor }}</td>
                <td>{{ book.ventas }}</td>
                <td>
                    <button type="button" @click="editBook(book)">Editar</button>
                    <button type="button" @click="deleteBook(book)">Eliminar</button>
                </td>
            </tr>
        </tbody>



</div>

<script src="app.js"></script>.
</body>
</html>